# agent-perfect-website — environment variables
# Copy to .env (or .env.local) in the project you run the skill from, or export them in your shell.

# PageSpeed Insights API key (free). Required for scripts/psi.mjs, the official
# pagespeed.web.dev numbers. Without it the skill measures with local Lighthouse.
# Get one: Google Cloud Console → APIs & Services → enable "PageSpeed Insights API" → Credentials → API key.
PAGESPEED_API_KEY=

# Optional aliases the scripts also honor (leave blank if PAGESPEED_API_KEY is set):
# PSI_API_KEY=
# GOOGLE_API_KEY=

# Optional: point is-agentic.mjs at a different Is Agentic deployment (default https://is-agentic.com).
# IS_AGENTIC_API_ORIGIN=
